{
  "name": "opendlms-studio",
  "version": "1.1.0",
  "description": "DLMS/COSEM protocol studio — Electron.js GUI for meter configuration and scripting",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:native": "cmake-js build --directory native",
    "rebuild": "electron-rebuild -f -w opendlms-native",
    "test": "node tests/test_native.js",
    "test:live": "electron test_lua_bridge_live.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron": "^28.3.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "cmake-js": "^7.3.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.opendlms.studio",
    "productName": "OpenDLMS Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "native/build/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "allowScripts": {
    "electron": true
  }
}
