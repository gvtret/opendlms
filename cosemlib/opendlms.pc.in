prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: opendlms
Description: Open-source DLMS/COSEM protocol stack (IEC 62056)
Version: @PROJECT_VERSION@
URL: https://github.com/open-dlms/opendlms
Libs: -L${libdir} -lcosemlib
Cflags: -I${includedir}/opendlms
