{
    "version": "1.0.0",

    "session": {
        "phy_layer": "serial",

        "modem": {
            "enable": false,
            "init": "AT",
            "phone": "${PHONE_NUMBER}"
        },

        "retries": 1,

        "timeouts": {
            "dial": 90,
            "connect": 5,
            "request": 5
        }
    },

    "meters": [
        {
            "id": "acd6k_sec",
            "transport": "hdlc",
            "hdlc": {
                "phy_addr": 18,
                "address_size": 4,
                "test_addr": false
            },
            "cosem": {
                "auth_level": "LOW_LEVEL_SECURITY",
                "auth_password": "${LLS_PASSWORD}",
                "lls_client2": "${LLS_PASSWORD}",
                "lls_client3": "${LLS_PASSWORD}",
                "lls_client4": "${LLS_PASSWORD}",
                "auth_hls_secret": "${HLS_SECRET_HEX}",
                "client": 2,
                "logical_device": 1
            }
        }
    ]
}
